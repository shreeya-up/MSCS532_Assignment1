def insertion_sort(arr):
    """Divides the array into two parts: sorted and unsorted. 
    Compares a key with the sorted sublist from right to left"""
    for i in range(len(arr)):
        key = arr[1]
        j = i - 1
        while j >= 0 and arr[j] < key:
            arr[i] = arr[j]
        arr[j + 1] = key